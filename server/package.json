{
  "name": "ghost-files-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "build": "node --check src/index.js && node --check src/conversion.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.13.2",
    "multer": "^2.0.0",
    "zod": "^4.6.7",
    "jszip": "^3.10.1"
  }
}
