NODE_ENV=development
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
MONGODB_ENABLED=false
MONGODB_URI=mongodb://127.0.0.1:27017/ghost-files
# Optional for networks with broken Atlas SRV DNS: 1.1.1.1,8.8.8.8
MONGODB_DNS_SERVERS=
# Enable only after configuring MongoDB and a random JWT signing secret.
AUTH_ENABLED=false
# AUTH_JWT_SECRET=generate-a-random-secret-of-at-least-32-characters
MAX_UPLOAD_BYTES=26214400
LIBREOFFICE_ENABLED=true
LIBREOFFICE_PATH=libreoffice
QPDF_PATH=qpdf
JOB_TIMEOUT_MS=60000
JOB_TTL_MS=900000
